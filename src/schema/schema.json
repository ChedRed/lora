{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Lora Configuration Schema",
  "description": "Schema for lora.json",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "default": "Lora App"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+\\.[a-z0-9]+\\.[a-z0-9]+$",
      "default": "red.ched.lora"
    }
  }
}